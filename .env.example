# Supabase Storage URL used to build public media URLs
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Canonical application URL used by OAuth callbacks and metadata
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# One-off local asset upload only. Never expose this as NEXT_PUBLIC_*.
SUPABASE_SECRET_KEY=sb_secret_your-key

# Better Auth / Drizzle server configuration
DATABASE_URL=<Supabase Session Pooler connection URI>
# Required in production. Development falls back to a local-only secret if blank.
BETTER_AUTH_SECRET=replace-with-a-random-32-byte-secret
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Explicit local-only dev bypass. Never enable in production.
# When true, server actions treat requests as AUTH_DEV_BYPASS_ROLE without OAuth.
AUTH_DEV_BYPASS=false
AUTH_DEV_BYPASS_ROLE=admin
